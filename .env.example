# Copy this file to .env and fill in your values. .env is gitignored (.env*),
# so the bot password is never committed. Used by tools/deploy_wiki.py.
#
# Create the bot password on the wiki at Special:BotPasswords (grant at least
# "Edit existing pages"); it gives you the WIKI_USER and WIKI_BOT_PASSWORD.

WIKI_API_URL=https://YOUR-WIKI.fandom.com/api.php
WIKI_USER=TechFilmer@deploy
WIKI_BOT_PASSWORD=the-long-token-it-gave-you
