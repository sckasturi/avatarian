# macOS Finder metadata — noise, and it churns on every commit
.DS_Store

# Quick Look thumbnails generated while checking glyph renders
*.qlgenerator

# Local tool permissions — per-machine, not project config
.claude/settings.local.json

# The designer's server imports build_glyphs, so tools/ now gets compiled
__pycache__/
*.pyc

# Reference images filed by the workbench. They are PROVENANCE — the
# corpus cites them by filename and tools/build_corpus.py checks each one
# is present — but they are other people's screenshots and stills, so
# whether they belong in a public repo is a licensing question, not a
# technical one. Kept locally until that is decided; the `sources` map in
# corpus/attested.json describes each one in words either way.
corpus/sources/*
!corpus/sources/.gitkeep
