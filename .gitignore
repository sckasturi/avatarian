# macOS Finder metadata — noise, and it churns on every commit
.DS_Store

# Quick Look thumbnails generated while checking glyph renders
*.qlgenerator

# Local tool permissions — per-machine, not project config
.claude/settings.local.json

# The designer's server imports build_glyphs, so tools/ now gets compiled
__pycache__/
*.pyc

# Reference images filed by the workbench. They are PROVENANCE — the
# corpus cites each by filename. corpus/sources/ is the workbench's
# WORKING directory and stays local; the committed, deployed copy lives
# in site/sources/ (build_corpus.py's sync_images() keeps it in step), so
# the public corpus page can link to a source. Publishing the images was
# a deliberate call — the licensing question this file used to defer.
corpus/sources/*
!corpus/sources/.gitkeep

# Scratch/analysis pages served locally, not shipped
site/_*.html

# Internal working docs — dev process, not for publication. The session
# handoff log, the backlog, and the "how to continue" context. Everything
# a reader needs is in README.md, AVATARIAN.md, and DECIPHERMENT.md.
HANDOFF.md
TODO.md
CONTEXT.md
CORPUS.md

# CSS-only mobile-render exploration (see CSS_MOBILE.md). Internal WIP —
# the generator, its note, and the generated stylesheet. Not shipped.
CSS_MOBILE.md
tools/build_css_only.py
Avatarian-css-only.css
